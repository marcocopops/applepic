<?xml version="1.0"?>
<!--
  ApplePic: mower-style differential-drive base (~0.60 x 0.45 m) with a ground-facing
  front camera, a basket (visual only) and a "magic" gripper link at the front bottom.
  Frames: base_footprint (ground) -> base_link -> wheels / caster / camera / gripper / basket.
-->
<robot name="applepic" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Chassis -->
  <xacro:property name="base_length" value="0.60"/>
  <xacro:property name="base_width" value="0.45"/>
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="base_mass" value="12.0"/>
  <!-- above the apples (8 cm tall): the chassis drives over them instead of pushing them -->
  <xacro:property name="ground_clearance" value="0.10"/>

  <!-- Drive wheels, 10 cm behind the chassis centre. base_footprint/base_link sit on the wheel
       axis (rotation centre), so the chassis box is offset forward by chassis_x. -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_mass" value="1.0"/>
  <xacro:property name="wheel_separation" value="0.52"/>
  <xacro:property name="chassis_x" value="0.10"/>

  <!-- Caster (frictionless sphere) at the front -->
  <xacro:property name="caster_radius" value="0.05"/>
  <xacro:property name="caster_x" value="0.32"/>

  <!-- Camera on a mast at the front, tilted towards the ground -->
  <xacro:property name="camera_x" value="0.35"/>
  <xacro:property name="camera_z" value="0.50"/>
  <xacro:property name="camera_pitch" value="0.85"/>
  <xacro:property name="camera_hfov" value="1.3"/>
  <xacro:property name="camera_width" value="640"/>
  <xacro:property name="camera_height" value="480"/>
  <xacro:property name="camera_rate" value="10"/>

  <!-- Gripper: point in front of the chassis, a few cm above ground -->
  <xacro:property name="gripper_x" value="0.46"/>
  <xacro:property name="gripper_z" value="0.04"/>

  <!-- GPS antenna above the wheel axis (rotation centre): no horizontal lever arm. The gz fix is
       perfect; the GPS error model is applied by the gps_noise node (metres, seeded). -->
  <xacro:property name="gps_z" value="0.40"/>
  <xacro:property name="gps_rate" value="10"/>
  <!-- IMU gyro (yaw rate for the heading: the wheels slip when pivoting): white noise and a
       constant bias drawn at start (gz noise, seeded by the gz sim seed option). -->
  <xacro:property name="imu_rate" value="50"/>
  <xacro:property name="gyro_noise" value="0.005"/>
  <xacro:property name="gyro_bias_stddev" value="0.0005"/>

  <xacro:property name="base_z" value="${ground_clearance + base_height / 2}"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m * (y*y + z*z) / 12}" ixy="0" ixz="0"
             iyy="${m * (x*x + z*z) / 12}" iyz="0"
             izz="${m * (x*x + y*y) / 12}"/>
  </xacro:macro>

  <material name="body_orange"><color rgba="0.95 0.55 0.1 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="basket_brown"><color rgba="0.45 0.3 0.15 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="${chassis_x} 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="body_orange"/>
    </visual>
    <collision>
      <origin xyz="${chassis_x} 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <!-- Bumper strip, wider than the wheels so that a trunk touches it first -->
    <collision name="bumper_strip">
      <origin xyz="${chassis_x} 0 0"/>
      <geometry><box size="${base_length} ${wheel_separation + wheel_width + 0.04} 0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="${chassis_x} 0 0"/>
      <mass value="${base_mass}"/>
      <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel" params="side y_sign">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12}"
                 ixy="0" ixz="0"
                 iyy="${wheel_mass * wheel_radius * wheel_radius / 2}" iyz="0"
                 izz="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y_sign * wheel_separation / 2} ${wheel_radius - base_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <collision><surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface></collision>
    </gazebo>
  </xacro:macro>

  <xacro:wheel side="left" y_sign="1"/>
  <xacro:wheel side="right" y_sign="-1"/>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_radius - base_z}"/>
  </joint>
  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <!-- Wheels and caster drive over the apples (mask 0x02): colliding, they launch them tens of metres. -->
    <collision><surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface></collision>
  </gazebo>

  <!-- Basket on the rear half of the chassis (visual only: apples are counted, not stored) -->
  <link name="basket_link">
    <visual>
      <geometry><box size="0.28 0.38 0.12"/></geometry>
      <material name="basket_brown"/>
    </visual>
  </link>
  <joint name="basket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="basket_link"/>
    <origin xyz="${chassis_x - 0.14} 0 ${base_height / 2 + 0.06}"/>
  </joint>

  <!-- Camera mast -->
  <link name="mast_link">
    <visual>
      <geometry><box size="0.03 0.03 ${camera_z - base_z - base_height / 2}"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="${camera_x - 0.03} 0 ${base_height / 2 + (camera_z - base_z - base_height / 2) / 2}"/>
  </joint>

  <!-- camera_link: x forward (gz convention), pitched down -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.08 0.04"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- ROS optical frame: z forward, x right, y down -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- "Magic" gripper: apples within a few cm of this frame get picked -->
  <link name="gripper_link">
    <visual>
      <geometry><box size="0.06 0.20 0.02"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="gripper_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="gripper_link"/>
    <origin xyz="${gripper_x} 0 ${gripper_z}"/>
  </joint>

  <link name="gps_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="gps_link"/>
    <origin xyz="0 0 ${gps_z}"/>
  </joint>

  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <always_on>true</always_on>
      <update_rate>${gps_rate}</update_rate>
      <topic>gps/raw</topic>
      <gz_frame_id>gps_link</gz_frame_id>
    </sensor>
  </gazebo>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>${imu_rate}</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>${gyro_noise}</stddev>
              <bias_mean>0</bias_mean>
              <bias_stddev>${gyro_bias_stddev}</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>${camera_rate}</update_rate>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera>
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <horizontal_fov>${camera_hfov}</horizontal_fov>
        <image>
          <width>${camera_width}</width>
          <height>${camera_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>30</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Bumper: contact sensor on the chassis and on its bumper strip, both lumped into base_footprint.
       Not on the wheels: they always touch the ground, which would flood the topic at the physics rate. -->
  <gazebo reference="base_link">
    <sensor name="chassis_bumper" type="contact">
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <contact>
        <collision>base_footprint_fixed_joint_lump__base_link_collision</collision>
        <collision>base_footprint_fixed_joint_lump__bumper_strip_collision_1</collision>
        <topic>/bumper</topic>
      </contact>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_velocity>1.0</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>wheel_odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
      <tf_topic>wheel_odom/tf</tf_topic>
    </plugin>
    <!-- Ground-truth odometry (world pose of the robot), used for navigation until GPS (M9) -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <tf_topic>odom/tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>
</robot>
