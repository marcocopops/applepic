<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>applepic_mission</name>
  <version>0.1.0</version>
  <description>Mission state machine (trees, search, pick, unload).</description>
  <maintainer email="38975865+marcocopops@users.noreply.github.com">Marc-Antoine Meunier</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>applepic_navigation</exec_depend>
  <!-- gz-transport Python bindings (python3-gz-transport13, shipped with gz Harmonic) -->

  <test_depend>applepic_gazebo</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
